# Copied to %APPDATA%\NiftyAnalyzer\.env on first install if you do not already
# have one. Kite secrets stay on this PC / the server — never commit them.

MARKET_DATA_MODE=replay
HOST=127.0.0.1
PORT=8000
ANALYZER_URL=http://127.0.0.1:8000
NEWS_ENABLED=1

# Switch to live and fill these for read-only Zerodha market data:
# MARKET_DATA_MODE=live
# KITE_API_KEY=
# KITE_API_SECRET=
# KITE_ACCESS_TOKEN=
