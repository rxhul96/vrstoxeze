# ---- execution mode -----------------------------------------------------------------------
# Paper trading is the default. Live orders need BOTH this flag AND a per-order confirmation in the UI.
ALLOW_LIVE_ORDERS=false
DESK_LIVE_CONFIRM_TTL_SEC=120
# Phrase typed to confirm a live order or clear a STOPPED_LOSSES / STOPPED_MANUAL stop.
DESK_CONFIRM_PHRASE=I ACCEPT THE RISK
# Reject signals outside 09:15-15:30 IST Mon-Fri (set false for after-hours paper testing).
DESK_MARKET_HOURS_ONLY=true
# SELL-to-open (option writing) is disabled unless true.
DESK_ALLOW_OPTION_WRITING=false

# ---- Kite Connect (only used when ALLOW_LIVE_ORDERS=true) ---------------------------------
KITE_API_KEY=
KITE_ACCESS_TOKEN=

# ---- sizing -------------------------------------------------------------------------------
DESK_DEFAULT_LOTS=1
DESK_MAX_LOTS=5
DESK_PRODUCT=MIS
DESK_ENTRY_ORDER_TYPE=MARKET
# Fallback lot sizes for paper mode (Kite instruments dump is used when live). NSE revises these.
DESK_LOT_NIFTY=75
DESK_LOT_BANKNIFTY=35
DESK_LOT_FINNIFTY=65
DESK_LOT_MIDCPNIFTY=140

# ---- daily governor -----------------------------------------------------------------------
DESK_MAX_TRADES_PER_DAY=5
DESK_MAX_LOSSES_PER_DAY=3
DESK_BASE_TIER_TRADES=3
# "Sure-shot" thresholds for trades 4-5
DESK_SURESHOT_MIN_WIN_RATE=0.70
DESK_SURESHOT_MIN_SAMPLE_TRADES=20
DESK_SURESHOT_MIN_OOS_SHARPE=1.5
DESK_SURESHOT_MIN_CONFIDENCE_PERCENTILE=0.90

# ---- strategy eligibility -----------------------------------------------------------------
DESK_ELIG_MIN_BACKTEST_TRADES=30
DESK_ELIG_MIN_OOS_SHARPE=1.0
DESK_ELIG_MIN_WIN_RATE=0.50
DESK_ELIG_MAX_DRAWDOWN_PCT=20
DESK_ELIG_MAX_TEST_AGE_DAYS=30

# ---- persistence / api --------------------------------------------------------------------
DESK_DB_PATH=data/desk.sqlite3
# If set, every /desk request must carry X-Desk-Token.
DESK_API_TOKEN=
DESK_CORS_ORIGINS=http://localhost:5173
