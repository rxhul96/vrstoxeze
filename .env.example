# Nifty Institutional Command Desk — server secrets stay on the server.
# Never copy these into the desktop bundle or commit them.

MARKET_DATA_MODE=live
ANALYZER_URL=http://127.0.0.1:8000
HOST=0.0.0.0
PORT=8000

# SQLite for laptop/dev. Docker Compose sets PostgreSQL.
DATABASE_URL=sqlite:///data/nifty_desk.sqlite
REDIS_URL=

# Zerodha Kite — one login shared by the analyzer (read-only market data) and the Trading Desk.
# The analyzer's client is sealed read-only; only the desk (below) can place orders.
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# --- Trading Desk (/desk) — governed NSE options desk, vendored in desk/ ----------------------
# Paper broker unless BOTH ALLOW_LIVE_ORDERS=true and Kite credentials are present.
# Live orders additionally need a per-order confirmation phrase in the Trading Desk window.
ALLOW_LIVE_ORDERS=false
DESK_CONFIRM_PHRASE=I ACCEPT THE RISK
DESK_MARKET_HOURS_ONLY=true
DESK_ALLOW_OPTION_WRITING=false
DESK_DEFAULT_LOTS=1
DESK_MAX_TRADES_PER_DAY=5
DESK_MAX_LOSSES_PER_DAY=3
# Defaults to <data dir>/desk.sqlite3. Optional X-Desk-Token header for every /desk route:
DESK_DB_PATH=
DESK_API_TOKEN=

# Analyzer -> desk signal adapter (backend/trading_desk/adapter.py)
DESK_ADAPTER_ENABLED=true
# Comma-separated subset of: composite_score,cvd_flow,oi_flow,ict_liquidity,price_action_ta,ai_master_analyst
DESK_ADAPTER_SOURCES=
DESK_ADAPTER_MIN_CONFIDENCE=0.6
DESK_ADAPTER_COOLDOWN_SEC=300
DESK_ADAPTER_ATM_DELTA=0.5
DESK_ADAPTER_UNDERLYING=NIFTY
# NIFTY weekly expiry weekday, Mon=0 (NSE moved index expiries to Tuesday in Sep 2025)
DESK_NIFTY_EXPIRY_WEEKDAY=1

# Optional NVIDIA NIM for analyst prose. Signals still come from quant engines.
NVIDIA_API_KEY=
NVIDIA_NIM_MODEL=

NEWS_ENABLED=1
ARCHIVE_AFTER_DAYS=14
